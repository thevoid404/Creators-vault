# ---------------------------------------------------------------------------
# Creators' Vault backend - environment variables
# Copy to .env and fill in. Every variable the app reads is listed here.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Public base URL of THIS api. Used to build OAuth callback URLs and to turn
# storage keys into absolute file URLs.
API_BASE_URL=http://localhost:4000
# Where the browser is sent after a successful OAuth login. The access and
# refresh tokens are appended as query params.
FRONTEND_URL=http://localhost:3000
# Comma-separated CORS allowlist. Use * only in local development.
CORS_ORIGINS=http://localhost:3000

# --- Database --------------------------------------------------------------
# Postgres must have the pgvector extension available (see README).
DATABASE_URL=postgresql://vault:vault@localhost:5432/creators_vault?schema=public

# --- JWT -------------------------------------------------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- Google OAuth (MANDATORY) ----------------------------------------------
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
# Authorized redirect URI must be exactly GOOGLE_CALLBACK_URL below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# --- GitHub OAuth (OPTIONAL) -----------------------------------------------
# Leave blank to disable. The GitHub routes then return 503 and Google is
# unaffected.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/v1/auth/github/callback

# --- Storage (StorageProvider) ---------------------------------------------
# local | s3 | cloudinary   (only "local" is implemented today)
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage
# Max size of a single uploaded file, in megabytes.
MAX_UPLOAD_SIZE_MB=100
# Per-user storage quota, in megabytes.
USER_STORAGE_QUOTA_MB=2048

# --- Embeddings (EmbeddingProvider) ----------------------------------------
# local | gemini | openai   (only "local" is implemented today)
EMBEDDING_DRIVER=local
# Must match the vector(N) dimension in prisma/schema.prisma. Changing this
# needs a migration and a re-index of every asset.
EMBEDDING_DIMENSIONS=384
# Only read when EMBEDDING_DRIVER=gemini.
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=text-embedding-004

# --- Payments (PaymentProvider) --------------------------------------------
# mock | stripe   (only "mock" is implemented today)
PAYMENT_DRIVER=mock
# Reserved for the future real implementation. Unused while PAYMENT_DRIVER=mock.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- URL import ------------------------------------------------------------
# Timeout in ms when fetching page metadata for /assets/from-url.
URL_IMPORT_TIMEOUT_MS=8000
# Cap on the HTML fetched while scraping metadata, in bytes.
URL_IMPORT_MAX_BYTES=1048576

# --- Extension tokens ------------------------------------------------------
# Lifetime of a browser-extension access token, in days. 0 = never expires.
EXTENSION_TOKEN_TTL_DAYS=365

# --- Rate limiting ---------------------------------------------------------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
